---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, whatsappUrl } from '../data/site';
import { servicos } from '../data/servicos';
import { zonas, zonaPath, fossaZonaPath, bairros, bairroPath } from '../data/locais';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo size={120} />
      <p>Desentupidora e limpa fossa 24 horas em São Paulo. Chegada em até {site.arrivalMinutes} minutos em todas as zonas da capital.</p>
      <ul class="footer-contact">
        <li><a href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a></li>
        <li><a href={site.tel}><Icon name="phone" size={18} /> {site.phoneDisplay}</a></li>
        <li><Icon name="clock" size={18} /> Aberto 24 horas, todos os dias</li>
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Serviços</h2>
      <ul class="footer-links">
        {servicos.map((s) => <li><a href={`/servicos/${s.slug}/`}>{s.nome}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Desentupidora por zona</h2>
      <ul class="footer-links">
        {zonas.map((z) => <li><a href={zonaPath(z)}>Desentupidora {z.em}</a></li>)}
      </ul>
      <h2 class="footer-title">Limpa fossa por zona</h2>
      <ul class="footer-links">
        {zonas.map((z) => <li><a href={fossaZonaPath(z)}>Limpa fossa {z.em}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Bairros</h2>
      <ul class="footer-links footer-links-2col">
        {bairros.map((b) => <li><a href={bairroPath(b)}>{b.nome}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {site.name}. Todos os direitos reservados.</p>
    <p>
      <a href="/areas-atendidas/">Áreas atendidas</a> · <a href="/blog/">Blog</a> ·
      <a href="/politica-de-privacidade/">Política de privacidade</a>
    </p>
  </div>
</footer>
