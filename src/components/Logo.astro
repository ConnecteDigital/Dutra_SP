---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';

interface Props {
  // Altura em pixels na tela
  size?: number;
}

const { size = 68 } = Astro.props;
---

<Image class="logo-img" src={logo} alt={site.name} height={size * 2} style={`height:${size}px;width:auto`} loading="eager" />
