---
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import { Image } from 'astro:assets';
import { fotoDoServico, temFotos } from '../data/fotos';
import { site } from '../data/site';
import { servicos } from '../data/servicos';
import { bairrosPorZona, bairroPath, zonaPath } from '../data/locais';
import { faqSchema } from '../data/schema';
import { getCollection } from 'astro:content';

const faq = [
  {
    q: 'O atendimento é 24 horas mesmo?',
    a: 'Sim. Atendemos 24 horas por dia, 7 dias por semana, incluindo fins de semana e feriados, em toda a cidade de São Paulo.',
  },
  {
    q: 'Em quanto tempo a desentupidora chega?',
    a: `Nossa equipe chega em até ${site.arrivalMinutes} minutos nas regiões atendidas.`,
  },
  {
    q: 'Quais regiões de São Paulo vocês atendem?',
    a: 'Atendemos as quatro zonas da capital (Sul, Leste, Norte e Oeste) e o Centro.',
  },
  {
    q: 'Vocês fazem limpa fossa também?',
    a: 'Sim. Além do desentupimento, fazemos limpa fossa, limpeza de caixa de gordura e hidrojateamento, com caminhão a vácuo.',
  },
  {
    q: 'Como eu chamo a desentupidora?',
    a: `É só chamar no WhatsApp ou ligar. Conte o que está acontecendo, de preferência com uma foto ou vídeo, e a equipe sai na hora para chegar em até ${site.arrivalMinutes} minutos.`,
  },
  {
    q: 'Atendem empresas e condomínios?',
    a: 'Sim. Atendemos residências, condomínios, restaurantes, comércios e indústrias.',
  },
];

const fotoGeral = fotoDoServico('geral');
const fotoSobre = fotoDoServico('hidrojateamento') ?? fotoGeral;

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
---

<Base
  title="Desentupidora 24 Horas em São Paulo | Chegamos em 20 min | Hidro Dutra SP"
  description={site.description}
  schema={[faqSchema(faq)]}
>
  <section class="hero hero-home">
    {
      fotoGeral && (
        <Image
          class="hero-bg"
          src={fotoGeral.src}
          alt=""
          widths={[480, 800, 1200, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="container hero-center">
      <span class="eyebrow">Desentupidora e limpa fossa · Plantão 24h</span>
      <h1>Desentupidora 24 horas em São Paulo: <em>chegamos em até {site.arrivalMinutes} minutos</em></h1>
      <p class="hero-lead">Pia, ralo, vaso ou esgoto entupido? Fossa cheia? Atendemos agora, a qualquer hora, em toda a capital.</p>
      <CtaButtons />
      <ul class="hero-badges">
        <li><Icon name="clock" size={22} /> <span>Atendimento 24h</span></li>
        <li><Icon name="bolt" size={22} /> <span>Chegada em até {site.arrivalMinutes} min</span></li>
        <li><Icon name="pin" size={22} /> <span>Toda São Paulo</span></li>
      </ul>
    </div>
  </section>

  <section class="trust" aria-label="Diferenciais">
    <div class="container trust-grid">
      <div class="trust-item"><Icon name="clock" size={34} /><div><strong>24 horas</strong><span>Todos os dias, inclusive feriados</span></div></div>
      <div class="trust-item"><Icon name="bolt" size={34} /><div><strong>{site.arrivalMinutes} minutos</strong><span>Tempo de chegada</span></div></div>
      <div class="trust-item"><Icon name="truck" size={34} /><div><strong>Limpa fossa</strong><span>Caminhão a vácuo e hidrojato</span></div></div>
      <div class="trust-item"><Icon name="pin" size={34} /><div><strong>São Paulo</strong><span>Zonas Sul, Leste, Norte, Oeste e Centro</span></div></div>
    </div>
  </section>

  <section class="section section-soft" id="servicos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nossos serviços</span>
        <h2>Desentupimento e limpa fossa em São Paulo</h2>
        <p>Da pia da cozinha à rede de esgoto do condomínio: desentupimento, hidrojateamento, limpa fossa e limpeza de caixa de gordura.</p>
      </div>
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Como funciona</span>
        <h2>Do chamado ao problema resolvido</h2>
        <p>Sem enrolação: você chama, a gente chega e resolve.</p>
      </div>
      <div class="steps">
        <div class="step-card">
          <h3>Chame no WhatsApp ou ligue</h3>
          <p>Conte o que está acontecendo. Se puder, mande uma foto ou um vídeo do problema.</p>
        </div>
        <div class="step-card">
          <h3>Chegamos em até {site.arrivalMinutes} minutos</h3>
          <p>Assim que você chama, a equipe mais próxima já sai para o seu endereço, a qualquer hora do dia ou da noite.</p>
        </div>
        <div class="step-card">
          <h3>Desentupimos e testamos</h3>
          <p>Fazemos o serviço com o equipamento certo para cada caso e testamos o escoamento na sua frente.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class:list={['container', { 'about-grid': fotoSobre }]}>
      {
        fotoSobre && (
          <div class="about-photo">
            <Image src={fotoSobre.src} alt={fotoSobre.alt} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 460px" />
          </div>
        )
      }
      <div>
        <div class="section-head">
          <span class="eyebrow">Por que a Hidro Dutra SP</span>
          <h2>Desentupidora de verdade, a qualquer hora</h2>
          <p>Equipamento para cada tipo de entupimento, do cabo flexível para a pia ao caminhão de hidrojateamento para a rede de esgoto.</p>
        </div>
        <div class="features">
          <div class="feature">
            <Icon name="clock" size={30} />
            <div><h3>Plantão 24 horas</h3><p>Entupimento não espera horário comercial. Atendemos de madrugada, fins de semana e feriados.</p></div>
          </div>
          <div class="feature">
            <Icon name="bolt" size={30} />
            <div><h3>Chegamos em {site.arrivalMinutes} minutos</h3><p>Equipes distribuídas pelas quatro zonas e pelo Centro, para chegar rápido onde você estiver.</p></div>
          </div>
          <div class="feature">
            <Icon name="truck" size={30} />
            <div><h3>Desentupimento e limpa fossa</h3><p>Um chamado só para resolver do ralo do banheiro ao esgotamento da fossa e da caixa de gordura.</p></div>
          </div>
          <div class="feature">
            <Icon name="building" size={30} />
            <div><h3>Casas, prédios e empresas</h3><p>Atendemos residências, condomínios, restaurantes, comércios e indústrias.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />

  {
    temFotos && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Trabalhos realizados</span>
            <h2>Serviços que já fizemos</h2>
            <p>Fotos reais de atendimentos da {site.name}.</p>
          </div>
          <Gallery limit={8} />
        </div>
      </section>
    )
  }

  <section class="section section-soft" id="areas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Áreas atendidas</span>
        <h2>Desentupidora perto de você</h2>
        <p>Atendemos toda a cidade de São Paulo. Escolha a sua zona ou o seu bairro.</p>
      </div>
      <div class="zones">
        {
          bairrosPorZona().map((g) => (
            <div class="zone">
              <h3><a href={zonaPath(g.zona)}>{g.zona.nome}</a></h3>
              <ul>
                {g.bairros.map((b) => (
                  <li>
                    <a href={bairroPath(b)}>
                      <Icon name="pin" size={16} /> {b.nome}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Blog</span>
            <h2>Dicas para evitar entupimento</h2>
          </div>
          <div class="posts">
            {posts.map((p) => (
              <a class="post-card" href={`/blog/${p.id}/`}>
                <time datetime={p.data.data.toISOString()}>{p.data.data.toLocaleDateString('pt-BR')}</time>
                <h3>{p.data.titulo}</h3>
                <p>{p.data.descricao}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section-soft">
    <div class="container" style="max-width: 860px">
      <div class="section-head">
        <span class="eyebrow">Dúvidas frequentes</span>
        <h2>Perguntas frequentes</h2>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand title="Precisa de uma desentupidora agora?" />
</Base>
